FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY patient-app/package.json patient-app/package-lock.json ./patient-app/
RUN npm ci --prefix patient-app --no-audit --no-fund
COPY . .
RUN npm run build:platform

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production PORT=3000 ONCOFLOW_PATIENT_WEB_DIR=/app/dist/app ONCOFLOW_DEMO_STATE_PATH=/data/state.json
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund && mkdir -p /data && chown node:node /data
COPY --from=build /app/dist ./dist
COPY platform/start.mjs ./platform/start.mjs
USER node
VOLUME ["/data"]
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "platform/start.mjs"]
