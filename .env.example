# Copie para .env e preencha. O .env nunca vai para o git.
# O repositório tem dois projetos: o MVP da demo na raiz (base IRIS, Node) e a arquitetura-alvo
# em backend/ + frontend/ (FastAPI). Cada um usa só as variáveis da sua seção.

# ---------------------------------------------------------------------------
# MVP da demo (raiz: npm run dev, porta 3000)
# ---------------------------------------------------------------------------

# GEMINI_API_KEY: opcional. Usada só para transcrever a fala do paciente (Lia e check-in por voz).
# Sem ela, tudo funciona por texto e o app pede para a pessoa digitar ou tocar numa sugestão.
# No AI Studio, a chave é injetada a partir dos Secrets do projeto.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL onde o app está hospedado (injetada pelo AI Studio/Cloud Run).
APP_URL="MY_APP_URL"

# PORT: porta do servidor local (padrão 3000).
# PORT=3000

# ---------------------------------------------------------------------------
# Arquitetura-alvo (backend/ FastAPI + frontend/ Vite)
# ---------------------------------------------------------------------------

# Banco (o docker compose usa estes valores para criar o Postgres local)
POSTGRES_USER=oncoflow
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=oncoflow
DATABASE_URL=postgresql+asyncpg://oncoflow:troque-esta-senha@localhost:5432/oncoflow

# Autenticação: gere com  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SEGREDO=
JWT_MINUTOS=15

# Modo demonstração: liga /api/demo/* (reset, troca de usuário) e os usuários fictícios.
# Nunca ligue fora da demo.
DEMO_MODE=true
# Senha dos usuários fictícios da demo (login por e-mail e senha)
DEMO_SENHA=troque-esta-senha

# IA e voz: "fixture" usa respostas gravadas (padrão da demo e dos testes); "claude" chama a API
IA_MODO=fixture
ANTHROPIC_API_KEY=
ONCOFLOW_MODELO_IA=claude-sonnet-5-5
ONCOFLOW_MODELO_LIA=claude-sonnet-5-5
