{
  "name": "oncoflow-patient",
  "version": "0.11.1",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:vad": "node scripts/copy-vad-assets.mjs",
    "predev": "npm run prepare:vad",
    "prebuild": "npm run prepare:vad",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "android:sync": "npm run build && cap sync android",
    "apk:debug": "powershell -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "format": "prettier --write src shared tests *.ts *.json index.html"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/status-bar": "8.0.4",
    "@ricky0123/vad-web": "0.0.31",
    "lucide-react": "1.66.0",
    "onnxruntime-web": "1.22.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
