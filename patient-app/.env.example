# MVP privado Android: o build incorpora estas chaves no APK por escolha explicita do usuario. Nao distribuir publicamente.
# Modelo sem segredos. Copie para .env apenas se o arquivo ainda nao existir.
# Navegacao ficticia abre offline; IA e voz usam os provedores abaixo. Pareamento e relatos conectados usam a API do painel.

LLM_PROVIDER=ollama
STT_PROVIDER=openai
TTS_PROVIDER=elevenlabs

# Conversa da Lia via Ollama. No emulador Android, 10.0.2.2 aponta para o computador host.
# Em telefone físico, use o endereço LAN do computador e configure o Ollama/gateway com acesso seguro.
OLLAMA_BASE_URL=http://10.0.2.2:11434
OLLAMA_MODEL=onco-llama3.1:latest

# OpenAI continua usada apenas para STT e transcrição em tempo real.
OPENAI_API_KEY=

# Chave ElevenLabs e ID da voz da Lia.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Modelos selecionados para a integracao.
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

ELEVENLABS_TTS_STABILITY=0.6

ELEVENLABS_TTS_SIMILARITY_BOOST=0.75

ELEVENLABS_TTS_STYLE=0

ELEVENLABS_TTS_SPEED=0.95

ELEVENLABS_TTS_USE_SPEAKER_BOOST=false
