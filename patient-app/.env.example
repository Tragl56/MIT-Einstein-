# MVP privado Android 0.2: o build incorpora estas chaves no APK por escolha explicita do usuario. Nao distribuir publicamente.
# Modelo sem segredos. Copie para .env apenas se o arquivo ainda nao existir.
# O APK atual funciona offline e ainda nao consome esta configuracao.

LLM_PROVIDER=openai
STT_PROVIDER=openai
TTS_PROVIDER=elevenlabs

# Uma chave OpenAI para LLM e STT.
OPENAI_API_KEY=

# Chave ElevenLabs e ID da voz da Lia.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Modelos selecionados para a integracao.
OPENAI_LLM_MODEL=gpt-4o
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

ELEVENLABS_TTS_STABILITY=0.6

ELEVENLABS_TTS_SIMILARITY_BOOST=0.75

ELEVENLABS_TTS_STYLE=0

ELEVENLABS_TTS_SPEED=0.95

ELEVENLABS_TTS_USE_SPEAKER_BOOST=false
