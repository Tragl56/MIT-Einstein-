{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "oncoflow",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "platform",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:platform"],
      "port": 3000
    },
    {
      "name": "backend",
      "runtimeExecutable": "backend\\.venv\\Scripts\\python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--app-dir", "backend", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "pro",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev:pro"],
      "port": 5173
    },
    {
      "name": "paciente",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev:paciente"],
      "port": 5174
    },
    {
      "name": "patient-app",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "patient-app", "run", "dev", "--", "--port", "5175", "--strictPort"],
      "port": 5175,
      "url": "http://127.0.0.1:5175"
    }
  ]
}
